<?xml version="1.0" encoding="utf-8"?>
<!--
  Kluvs Loading Spinner — static VectorDrawable
  Drop into res/drawable/spinner_kluvs.xml

  Coordinate system: original mark viewBox (0 0 394.41 402.02), now embedded in a
  500x500 viewport centered on the rotation/scale pivot (197.21, 176) — same
  half-extent-250 padding already proven out in spinner-kluvs.svg / KluvsSpinner.tsx
  (see their "max reach ~240 units accommodates scale(1.08)" comment). VectorDrawable
  clips to its own viewport internally, so this padding must live here, not on the
  consuming View/AndroidView — the outer container can be sized however the caller
  likes, but the mark itself would still clip mid-animation without this.
  Rotation/scale pivot (in the inner, unpadded coordinate space): (197.21, 176) —
  centroid of the three hexagons.
  Initial state is the exhale rest pose (rotation=0, scale=0.96, alpha=0.94).

  Pair with spinner_kluvs_animation.xml (animated-vector wrapper).
  Requires res/animator/ and res/interpolator/ files from this bundle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:name="root"
    android:width="40.56dp"
    android:height="40.56dp"
    android:viewportWidth="500"
    android:viewportHeight="500"
    android:alpha="0.94">

    <group
        android:name="spinner_pad"
        android:translateX="52.79"
        android:translateY="74">

        <group
            android:name="spinner_group"
            android:pivotX="197.21"
            android:pivotY="176"
            android:rotation="0"
            android:scaleX="0.96"
            android:scaleY="0.96">

            <!-- Outer dodecagon outline -->
            <path
                android:pathData="M11,68.51 L110.6,11 L197.21,61 L283.81,11 L383.41,68.51 L383.41,183.52 L296.81,233.52 L296.81,333.52 L197.21,391.02 L97.6,333.52 L97.6,233.52 L11,183.52 Z"
                android:fillColor="#00000000"
                android:strokeColor="#D16D30"
                android:strokeWidth="14"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"/>

            <!-- Top-left hexagon -->
            <path
                android:pathData="M191.58,79.26 L191.58,172.76 L110.6,219.51 L29.63,172.76 L29.63,79.26 L110.6,32.51 Z"
                android:fillColor="#D16D30"/>

            <!-- Top-right hexagon -->
            <path
                android:pathData="M364.78,79.26 L364.78,172.76 L283.81,219.51 L202.83,172.76 L202.83,79.26 L283.81,32.51 Z"
                android:fillColor="#D16D30"/>

            <!-- Bottom hexagon -->
            <path
                android:pathData="M278.18,229.26 L278.18,322.76 L197.21,369.51 L116.23,322.76 L116.23,229.26 L197.21,182.51 Z"
                android:fillColor="#D16D30"/>

        </group>
    </group>
</vector>
